      "description": "Unselected and selected gallery filters; state is expressed by aria-pressed.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Example brand mockup filters\"><button type=\"button\" class=\"ds-filter\" aria-pressed=\"true\">All applications</button><button type=\"button\" class=\"ds-filter\" aria-pressed=\"false\">On the road</button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:10px}.ds-filter{font-family:var(--body,Manrope,Arial,sans-serif);background:transparent;border:1px solid #9aafac;color:var(--ink,#082c32);padding:10px 18px;font-size:12px;min-height:42px;border-radius:0;cursor:pointer;transition:background .25s,color .25s}.ds-filter:hover{background:#e1ece8}.ds-filter[aria-pressed=true]{background:var(--teal,#007f89);border-color:var(--teal,#007f89);color:var(--white,#fff)}.ds-filter:focus-visible{outline:3px solid var(--red,#d52c34);outline-offset:5px;}@media(max-width:620px){.ds-filter{padding:9px 13px}}@media(prefers-reduced-motion:reduce){.ds-filter{transition:none}}"
    },
    {
      "name": "Editorial service row",
      "kind": "card",
      "refersTo": "service-row",
      "description": "The implemented flat container pattern, with rules rather than raised card chrome.",
      "html": "<article class=\"ds-service-row\"><a href=\"services.html#road-freight\"><h3>Road freight</h3><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 5l7 7-7 7\"/></svg></a><p>Make room for your next delivery, with a freight enquiry shaped around your cargo and destination.</p></article>",
      "css": ".ds-service-row{font-family:var(--body,Manrope,Arial,sans-serif);padding:27px 0;border-top:1px solid var(--line,#d5dfdd);border-bottom:1px solid var(--line,#d5dfdd);color:var(--ink,#082c32)}.ds-service-row a{display:flex;align-items:center;justify-content:space-between;gap:20px;color:inherit;text-decoration:none}.ds-service-row h3{margin:0;font-size:23px;font-weight:700;line-height:1.25;letter-spacing:-.025em}.ds-service-row p{font-size:13px;line-height:1.7;color:var(--muted,#526a6d);margin:12px 0 0;max-width:400px}.ds-service-row svg{width:22px;height:22px;fill:none;stroke:var(--teal,#007f89);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-service-row:hover h3{color:var(--teal,#007f89)}.ds-service-row a:focus-visible{outline:3px solid var(--red,#d52c34);outline-offset:5px;}@media(max-width:900px){.ds-service-row{padding-block:21px}.ds-service-row h3{font-size:19px}}@media(max-width:620px){.ds-service-row{padding-block:24px}.ds-service-row h3{font-size:22px}.ds-service-row p{font-size:14px;max-width:320px}}"
    },
    {
      "name": "Proposal status label",
      "kind": "chip",
      "refersTo": "proposal-label",
      "description": "Concept status marker on the dark brand-vision surface.",
      "html": "<div class=\"ds-proposal-stage\"><span class=\"ds-proposal-label\">Proposed rebranding concept · For discussion</span></div>",
      "css": ".ds-proposal-stage{background:var(--deep,#05252b);padding:20px}.ds-proposal-label{font-family:var(--body,Manrope,Arial,sans-serif);display:inline-flex;align-items:center;gap:8px;font-size:12px;line-height:1.7;padding:5px 10px;border:1px solid #55777b;color:#e5f4f3}.ds-proposal-label::before{content:\"\";width:5px;height:5px;border-radius:50%;background:var(--turquoise,#13c1c5);flex-shrink:0}"
    },
    {
      "name": "Directional route trace",
      "kind": "custom",
      "description": "Decorative route marker used beneath the commitment section; pauses under reduced motion.",
      "html": "<div class=\"ds-route-line\" aria-hidden=\"true\"></div>",
      "css": ".ds-route-line{height:2px;background:#b1d5d1;position:relative;overflow:hidden;margin-top:50px}.ds-route-line::after{content:\"\";width:16%;height:100%;display:block;background:var(--teal,#007f89);animation:ds-line-run 6s linear infinite}@keyframes ds-line-run{from{transform:translateX(-100%)}to{transform:translateX(700%)}}@media(prefers-reduced-motion:reduce){.ds-route-line::after{animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "Moving Business Forward",
    "overview": "The supplied identity anchors a confident, directional system: large freight photography, compressed heavy headlines, clear humanist copy and precise horizontal rules. White and paper surfaces give way to teal calls to action and deep teal editorial sections; turquoise carries emphasis and movement.\n\nPreserve the exact supplied logo artwork, corrected arrow, lettering, proportions and slogan. This is a source-derived record of the implemented proposal, grounded in `PRODUCT.md`, `DIRECTION.md`, `styles.css`, `index.html`, `contact.html`, `rebrand.html` and `app.js`; it does not claim rendered approval.",
    "keyCharacteristics": [
      "Intact supplied identity on white logo stages.",
      "Oversized Barlow headings paired with Manrope information.",
      "Flat rectangular surfaces, fine rules and generous section spacing.",
      "Directional arrows, route traces and optional restrained motion."
    ],
    "rules": [
      {
        "name": "The Identity Rule",
        "body": "Preserve the supplied logo as an image; do not reconstruct or recolour its lettering, arrow or slogan.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Keep ordinary editorial rows and form containers flat; retain shadows in their implemented overlay or artwork-study contexts.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the supplied logo artwork intact on its white stage.",
      "Do pair heavy Barlow headings with clear Manrope copy and square controls.",
      "Do preserve fine rules, flat containers and subject-aware image crops.",
      "Do keep keyboard focus, native validation and reduced-motion behaviour visible and functional.",
      "Do retain illustrative/proposed labels around imagery and concept applications."
    ],
    "donts": [
      "Don't turn concept mockups into evidence of actual vehicles, premises or uniforms.",
      "Don't introduce rounded floating cards as the default editorial treatment.",
      "Don't replace the supplied logo with live text, a traced mark or a different arrow.",
      "Don't treat source inspection or an absent screenshot as rendered visual approval."
    ]
  }
}
