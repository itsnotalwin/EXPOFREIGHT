      "css": ".ds-field{font-family:var(--body,Manrope,Arial,sans-serif);display:flex;flex-direction:column;gap:8px;min-width:0;color:var(--ink,#082c32)}.ds-field label{font-size:12px;font-weight:800}.ds-field input{font-family:var(--body,Manrope,Arial,sans-serif);width:100%;border:1px solid #a8bcb8;border-radius:0;background:var(--white,#fff);color:var(--ink,#082c32);padding:13px 14px;font-size:12px;min-height:48px;caret-color:var(--teal,#007f89)}.ds-field input::placeholder{color:var(--muted,#526a6d)}.ds-field input:focus,.ds-field input:focus-visible{outline:2px solid var(--teal,#007f89);outline-offset:1px}.ds-field input:user-invalid{border-color:var(--red,#d52c34)}@media(max-width:620px){.ds-field input{font-size:16px;padding:11px 12px}}"
