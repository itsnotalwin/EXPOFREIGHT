      "css": ".ds-nav{font-family:var(--body,Manrope,Arial,sans-serif);display:flex;align-items:center;gap:28px;background:var(--white,#fff);color:var(--ink,#082c32);flex-wrap:wrap}.ds-nav a{position:relative;text-decoration:none;font-size:12px;font-weight:700;padding-block:14px;white-space:nowrap;color:inherit}.ds-nav a::after{content:\"\";position:absolute;bottom:5px;left:0;width:100%;height:2px;transform:scaleX(0);transform-origin:left;background:var(--teal,#007f89);transition:transform .3s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-nav a:hover::after,.ds-nav a[aria-current=page]::after{transform:scaleX(1)}.ds-nav .ds-vision-link{color:var(--teal,#007f89)}.ds-nav a:focus-visible{outline:3px solid var(--red,#d52c34);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-nav a::after{transition:none}}"
